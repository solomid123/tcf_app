NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SECRET_KEY=sb_secret_xxx
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Azure AI Foundry — question/audio/image generation scripts
AZURE_AI_KEY=
AZURE_AI_RESOURCE=
AZURE_TEXT_MODEL=

# Expression orale: Azure Voice Live relay (scripts/eo/relay.mjs, run with `npm run eo:relay`).
# The relay holds the Azure key server-side; the browser only ever talks to the relay.
EO_RELAY_PORT=8787
EO_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_EO_RELAY_URL=ws://localhost:8787/eo
